<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_border"
                        android:padding="2dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profileImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                            android:scaleType="centerCrop"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="CogniQuest"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="@color/tertiary_fixed"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 🔥 2500 XP"
                        android:textStyle="bold"
                        android:textColor="@color/on_tertiary_fixed"
                        android:textSize="12sp"/>
                </LinearLayout>

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Bottom border of AppBar -->
    <View
        android:id="@+id/appBarBorder"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1Ac7c4d8"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"/>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarBorder"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toStartOf="@id/filterButton"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textColor="@color/primary"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review your recent quests and scores."
                        android:textColor="@color/on_surface_variant"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/filterButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="@color/surface_container_high"
                    app:tint="@color/on_surface_variant"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Card 1: Advanced Biology -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1Ac7c4d8"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <FrameLayout
                            android:id="@+id/iconContainer1"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/rounded_bg"
                            android:backgroundTint="#1A006c49"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_compass"
                                app:tint="@color/secondary"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/iconContainer1"
                            android:layout_toStartOf="@id/scoreContainer1"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Advanced Biology"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today, 2:30 PM • 15 Mins"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/scoreContainer1"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/rounded_bg"
                            android:backgroundTint="#1A3f3bbd"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9"
                                android:textColor="@color/primary"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="/10"
                                android:textColor="#993f3bbd"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1Ac7c4d8"
                        android:layout_marginVertical="12dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <!-- Progress Dots -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/primary" android:backgroundTint="@color/primary" android:layout_marginEnd="4dp" android:backgroundTintMode="src_over" style="@style/ShapeAppearanceOverlay.App.CornerSize12dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/primary" android:backgroundTint="@color/primary" android:layout_marginEnd="4dp" android:backgroundTintMode="src_over"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/primary" android:backgroundTint="@color/primary" android:layout_marginEnd="4dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/surface_variant"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Details →"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: World Capitals -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1Ac7c4d8"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <FrameLayout
                            android:id="@+id/iconContainer2"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/rounded_bg"
                            android:backgroundTint="#1Aa2002c"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_compass"
                                app:tint="@color/tertiary"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/iconContainer2"
                            android:layout_toStartOf="@id/scoreContainer2"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="World Capitals"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Yesterday, 8:15 PM • 8 Mins"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/scoreContainer2"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/rounded_bg"
                            android:backgroundTint="@color/surface_container_high"
                            app:strokeColor="#1Ac7c4d8"
                            app:strokeWidth="1dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textColor="@color/on_surface_variant"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="/10"
                                android:textColor="#99464554"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1Ac7c4d8"
                        android:layout_marginVertical="12dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <!-- Progress Dots -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/tertiary" android:layout_marginEnd="4dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/surface_variant" android:layout_marginEnd="4dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/surface_variant" android:layout_marginEnd="4dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/surface_variant"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Details →"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Algebraic Patterns -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1Ac7c4d8"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <FrameLayout
                            android:id="@+id/iconContainer3"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/rounded_bg"
                            android:backgroundTint="#1A5856d6"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_compass"
                                app:tint="@color/primary_container"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/iconContainer3"
                            android:layout_toStartOf="@id/scoreContainer3"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Algebraic Patterns"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oct 24, 11:00 AM • 20 Mins"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/scoreContainer3"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/rounded_bg"
                            android:backgroundTint="#1A006c49"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:textColor="@color/secondary"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="/10"
                                android:textColor="#99006c49"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1Ac7c4d8"
                        android:layout_marginVertical="12dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <!-- Progress Dots -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/secondary" android:layout_marginEnd="4dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/secondary" android:layout_marginEnd="4dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/secondary" android:layout_marginEnd="4dp"/>
                            <View android:layout_width="24dp" android:layout_height="6dp" android:background="@color/secondary"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Details →"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Load More Button -->
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Load Older Quests"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/outline_variant"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_menu_more"
                app:iconGravity="textEnd"
                app:iconTint="@color/primary"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu_user"
        android:background="@color/surface"
        app:elevation="8dp"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"/>

</androidx.constraintlayout.widget.ConstraintLayout>
