<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvQuizTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Title"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/on_surface"/>
            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/on_surface" />
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#ba1a1a"
                android:layout_marginStart="8dp" />
        </LinearLayout>
        
        <TextView
            android:id="@+id/tvQuizDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">
            <TextView
                android:id="@+id/tvQuestionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 Questions"
                android:textColor="@color/on_surface"
                android:textSize="12sp"
                app:drawableStartCompat="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="4dp"/>
            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/circle_border"
                android:backgroundTint="@color/outline_variant"
                android:layout_marginHorizontal="8dp" />
            <TextView
                android:id="@+id/tvDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                app:drawableStartCompat="@android:drawable/ic_menu_compass"
                android:drawablePadding="4dp"
                app:drawableTint="@color/secondary"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
